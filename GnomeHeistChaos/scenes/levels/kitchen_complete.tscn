[node name="PlayerScript" type="Node" parent="GnomePlayer"]
script = {"source":"extends Node

@onready var player: CharacterBody3D = get_parent()
@onready var camera_pivot: Node3D = get_parent().get_node(\"CameraPivot\")
@onready var camera: Camera3D = camera_pivot.get_node(\"Camera3D\")

func _ready():
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)

func _physics_process(delta):
	var gravity = -9.81
	if not player.is_on_floor():
		player.velocity.y += gravity * delta
	
	if Input.is_action_just_pressed(\"jump\") and player.is_on_floor():
		player.velocity.y = 4.5
	
	var input_dir = Input.get_vector(\"move_left\", \"move_right\", \"move_forward\", \"move_back\")
	var direction = (player.transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	
	if direction:
		player.velocity.x = direction.x * 5.0
		player.velocity.z = direction.z * 5.0
	else:
		player.velocity.x = move_toward(player.velocity.x, 0, 5.0)
		player.velocity.z = move_toward(player.velocity.z, 0, 5.0)
	
	player.move_and_slide()

func _input(event):
	if event is InputEventMouseMotion and Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		camera_pivot.rotate_y(-event.relative.x * 0.002)
		camera.rotate_x(-event.relative.y * 0.002)
		camera.rotation.x = clamp(camera.rotation.x, -PI/2 + 0.1, PI/2 - 0.1)
"}

