[node name="GameManager" type="Node" parent="."]
script = {"source":"# Gestion simplifiée du jeu
extends Node

var chaos_level: float = 0.0
var max_chaos: float = 100.0
var score: int = 0
var time_left: float = 300.0
var is_game_active: bool = true

func _ready():
	process_mode = Node.PROCESS_MODE_ALWAYS

func _process(delta):
	if is_game_active:
		time_left -= delta
		if time_left <= 0:
			is_game_active = false
			print(\"Game Over!\")

func add_chaos(amount: float):
	chaos_level += amount
	chaos_level = clamp(chaos_level, 0.0, max_chaos)
	if chaos_level >= max_chaos:
		var owner = get_node(\"Owner\")
		if owner:
			owner.wake_up()

func add_score(points: int):
	score += points
	print(\"Score: \", score)
"}

[node name="AudioManager" type="Node" parent="."]
script = {"source":"# Gestion des sons
extends Node

func _ready():
	pass

func play_pickup():
	var player = AudioStreamPlayer.new()
	add_child(player)
	player.stream = load(\"res://assets/audio/pickup.wav\")
	player.play()

func play_break():
	var player = AudioStreamPlayer.new()
	add_child(player)
	player.stream = load(\"res://assets/audio/break.wav\")
	player.play()
"}

