[node name="GameManager" type="Node" parent="."]
script = {"source":"extends Node

var chaos_level: float = 0.0
var max_chaos: float = 100.0
var score: int = 0
var time_left: float = 300.0

func _ready():
	process_mode = Node.PROCESS_MODE_ALWAYS
	print(\"Game started! Steal items and avoid the owner.\")

func _process(delta):
	if time_left > 0:
		time_left -= delta
	else:
		print(\"Game Over! Score: \", score)
		get_tree().reload_current_scene()

func add_chaos(amount: float):
	chaos_level += amount
	if chaos_level >= max_chaos:
		var owner = get_node(\"Owner\")
		if owner:
			owner.wake_up()

func add_score(points: int):
	score += points
	print(\"Score: \", score)
"}

