[node name="OwnerScript" type="Node" parent="Owner"]
script = {"source":"extends Node

@onready var owner: CharacterBody3D = get_parent()
@onready var bed_position: Node3D = get_parent().get_node(\"BedPosition\")

var is_asleep: bool = true

func _ready():
	owner.global_position = bed_position.global_position

func _physics_process(delta):
	if is_asleep:
		owner.velocity = Vector3.ZERO
		return
	
	var players = get_tree().get_nodes_in_group(\"players\")
	if players.size() > 0:
		var target = players[0]
		var direction = (target.global_position - owner.global_position).normalized()
		owner.velocity.x = direction.x * 6.0
		owner.velocity.z = direction.z * 6.0
	else:
		var direction = (bed_position.global_position - owner.global_position).normalized()
		owner.velocity.x = direction.x * 3.0
		owner.velocity.z = direction.z * 3.0
		
		if owner.global_position.distance_to(bed_position.global_position) < 1.0:
			is_asleep = true
	
	owner.move_and_slide()

func wake_up():
	is_asleep = false
	print(\"Owner woke up! Run!\")
"}

