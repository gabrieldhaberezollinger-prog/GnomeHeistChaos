# Chaise en Bois - Modèle 3D Low-Poly Cartoon
# Format: OBJ (compatible Godot)
# Créé par Vibe Code

# Vertices (sommets)
# Assise
v -0.4 0.4 0.0    # 0: Coin avant-gauche
v 0.4 0.4 0.0     # 1: Coin avant-droit
v -0.4 0.4 -0.4   # 2: Coin arrière-gauche
v 0.4 0.4 -0.4    # 3: Coin arrière-droit

# Dossier
v -0.4 0.8 -0.4   # 4: Dossier haut-gauche
v 0.4 0.8 -0.4    # 5: Dossier haut-droit

# Pieds
v -0.3 0.0 0.3    # 6: Pied avant-gauche
v 0.3 0.0 0.3     # 7: Pied avant-droit
v -0.3 0.0 -0.3   # 8: Pied arrière-gauche
v 0.3 0.0 -0.3    # 9: Pied arrière-droit

# Textures (UVs)
vt 0.0 0.0         # 0: Coin avant-gauche
vt 1.0 0.0         # 1: Coin avant-droit
vt 0.0 1.0         # 2: Coin arrière-gauche
vt 1.0 1.0         # 3: Coin arrière-droit
vt 0.0 0.8         # 4: Dossier haut-gauche
vt 1.0 0.8         # 5: Dossier haut-droit
vt 0.1 0.1         # 6: Pied avant-gauche
vt 0.9 0.1         # 7: Pied avant-droit
vt 0.1 0.9         # 8: Pied arrière-gauche
vt 0.9 0.9         # 9: Pied arrière-droit

# Faces (triangles)
# Assise
f 0/0 1/1 3/3
f 0/0 3/3 2/2

# Dossier
f 2/2 3/3 5/5
f 2/2 5/5 4/4

# Pied avant-gauche
f 0/0 6/6 7/7
f 0/0 7/7 1/1

# Pied avant-droit
f 1/1 7/7 9/9
f 1/1 9/9 3/3

# Pied arrière-gauche
f 2/2 8/8 6/6
f 2/2 6/6 0/0

# Pied arrière-droit
f 3/3 9/9 8/8
f 3/3 8/8 2/2

# Côtés de l'assise
f 0/0 2/2 8/8
f 8/8 9/9 3/3
f 3/3 9/9 7/7
f 7/7 6/6 0/0
