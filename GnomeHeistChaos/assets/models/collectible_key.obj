# Clé Dorée - Objet à Voler
# Format: OBJ (compatible Godot)
# Créé par Vibe Code

# Vertices (sommets)
# Anneau de la clé
v 0.0 0.0 0.0       # 0: Centre anneau
v 0.2 0.0 0.0      # 1: Haut anneau
v 0.0 0.2 0.0      # 2: Droite anneau
v -0.2 0.0 0.0     # 3: Bas anneau
v 0.0 -0.2 0.0     # 4: Gauche anneau

# Tige de la clé
v 0.0 0.0 0.1      # 5: Base tige
v 0.0 0.0 0.5      # 6: Haut tige

# Dent de la clé (partie supérieure)
v 0.0 0.0 0.5      # 6: Base dent (même que haut tige)
v 0.1 0.1 0.6      # 7: Dent haut-gauche
v -0.1 0.1 0.6     # 8: Dent haut-droite
v 0.0 0.2 0.6      # 9: Dent haut-centre

# Textures (UVs)
vt 0.5 0.5         # 0: Centre anneau
vt 0.5 1.0         # 1: Haut anneau
vt 1.0 0.5         # 2: Droite anneau
vt 0.5 0.0         # 3: Bas anneau
vt 0.0 0.5         # 4: Gauche anneau
vt 0.5 0.6         # 5: Base tige
vt 0.5 0.8         # 6: Haut tige
vt 0.6 0.9         # 7: Dent haut-gauche
vt 0.4 0.9         # 8: Dent haut-droite
vt 0.5 0.95        # 9: Dent haut-centre

# Faces (triangles)
# Anneau (divisé en 4 triangles)
f 0/0 1/1 2/2
f 0/0 2/2 3/3
f 0/0 3/3 4/4
f 0/0 4/4 1/1

# Tige
f 5/5 1/1 6/6
f 5/5 6/6 3/3

# Dent de la clé
f 6/6 7/7 9/9
f 6/6 9/9 8/8
f 7/7 8/8 9/9
