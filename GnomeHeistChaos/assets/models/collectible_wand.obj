# Baguette Magique - Objet à Voler
# Format: OBJ (compatible Godot)
# Créé par Vibe Code

# Vertices (sommets)
# Baguette (longue et fine)
v 0.0 0.0 0.0       # 0: Base (tenue par le gnome)
v 0.0 0.0 1.0      # 1: Extrémité

# Étoile au bout de la baguette
v 0.0 0.0 1.0      # 1: Centre étoile (même que extrémité)
v 0.1 0.1 1.1      # 2: Pointe étoile 1
v -0.1 0.1 1.1     # 3: Pointe étoile 2
v 0.0 0.15 1.1     # 4: Pointe étoile 3
v 0.1 -0.1 1.1     # 5: Pointe étoile 4
v -0.1 -0.1 1.1    # 6: Pointe étoile 5

# Textures (UVs)
vt 0.5 0.0         # 0: Base
vt 0.5 1.0         # 1: Extrémité
vt 0.6 1.1         # 2: Pointe étoile 1
vt 0.4 1.1         # 3: Pointe étoile 2
vt 0.5 1.15        # 4: Pointe étoile 3
vt 0.6 0.9         # 5: Pointe étoile 4
vt 0.4 0.9         # 6: Pointe étoile 5

# Faces (triangles)
# Baguette (cylindre simplifié en 4 faces)
f 0/0 1/1 2/2
f 0/0 2/2 3/3
f 0/0 3/3 4/4
f 0/0 4/4 1/1

# Étoile (5 triangles)
f 1/1 2/2 3/3
f 1/1 3/3 4/4
f 1/1 4/4 5/5
f 1/1 5/5 6/6
f 1/1 6/6 2/2
